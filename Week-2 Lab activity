        "#Lists\n",
        "fruit = ['apple', 'banana', 'cherry', 'durian', 'elderberry']\n",
        "print(fruit[1])\n",
        "print(fruit[-2])\n",
        "print(fruit[0:2])\n",
        "print(fruit[3:5])\n",
        "print(fruit[1:4])\n",
        "\n",
