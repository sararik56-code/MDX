        "#Lists\n",
        "fruit = ['apple', 'banana', 'cherry', 'durian', 'elderberry']\n",
        "print(fruit[1])\n",
        "print(fruit[-2])\n",
        "print(fruit[0:2])\n",
        "print(fruit[3:5])\n",
        "print(fruit[1:4])\n",
        "\n",
        "fruit.append('orange')\n",
        "print(fruit) # adds 'orange' to the end of the list\n",
        "\n",
        "fruit.remove('cherry')\n",
        "print(fruit) # removes 'cherry' from the list\n",
        "\n",
        "fruit.pop()\n",
        "print(fruit) # removes the last item from the list"
